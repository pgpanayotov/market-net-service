# Copy to .env and adjust. docker compose reads .env automatically; every value has a default.

# PostgreSQL (the compose stack uses one user for migrations and the apps; see README for separate roles)
POSTGRES_DB=marketdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Admin API key for /api/admin/* (X-Api-Key header) and the console client's symbols commands.
# Change it for anything beyond local use.
ADMIN_API_KEY=dev-admin-key

# Host port for the HTTP API
API_PORT=8080

# Binance endpoints. Where the official hosts are blocked (e.g. HTTP 451), use the market-data-only mirrors:
#   BINANCE_REST_URL=https://data-api.binance.vision
#   BINANCE_SOCKET_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://api.binance.com
BINANCE_SOCKET_URL=wss://stream.binance.com:9443

# Optional OpenTelemetry OTLP endpoint (metrics/traces); empty = disabled
OTEL_EXPORTER_OTLP_ENDPOINT=
